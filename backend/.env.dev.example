# Local development settings (load with: node --env-file=.env, or `npm run dev` which uses tsx)
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:5173
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=bms_app
PG_PASSWORD=devpassword
PG_MASTER_DB=bms_master
# dev-only key — generate a real one for production with: openssl rand -hex 32
SECRETS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LOG_LEVEL=info
