# ---- Copy to .env on the server and fill in. NEVER commit .env ----
# Generate secrets with:  ./scripts/gen-secrets.sh
BMS_DOMAIN=bms.nexusrajan.com
ACME_EMAIL=admin@example.com

# PostgreSQL superuser (only used by the postgres container's init script and backups)
POSTGRES_SUPERUSER_PASSWORD=
# Application role: CREATEDB + CREATEROLE, NOT superuser. Provisions one database + one role per tenant.
BMS_DB_USER=bms_app
BMS_DB_PASSWORD=
BMS_MASTER_DB=bms_master
# 32-byte hex key that encrypts tenant DB passwords at rest (AES-256-GCM).
# Losing it means losing access to tenant databases — store a copy in your password manager.
BMS_SECRETS_KEY=
LOG_LEVEL=info
